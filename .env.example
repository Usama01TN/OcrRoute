# Every setting is OCRROUTE_<NAME>. Copy to .env or export in the environment.
OCRROUTE_HOME=~/.ocrroute            # data dir: sqlite db, artifacts, secret.key, backups
OCRROUTE_HOST=127.0.0.1
OCRROUTE_PORT=20256                  # never 20128 (reserved by another gateway)
# OCRROUTE_PANEL_PORT=20257          # split mode (ocrroute serve --panel-port 20257)
# OCRROUTE_SECRET_KEY=               # optional; otherwise a Fernet key is generated at ~/.ocrroute/secret.key (0600)
OCRROUTE_STORE_INPUTS=false          # keep uploaded inputs (enables retry)
OCRROUTE_PRIVACY_MODE=false          # no persistence of inputs, API engines refused, in-memory cache only
OCRROUTE_LOG_RETENTION_DAYS=30
OCRROUTE_CACHE_TTL_SECONDS=3600
OCRROUTE_MAX_UPLOAD_BYTES=26214400
OCRROUTE_MAX_PIXELS=60000000
OCRROUTE_MAX_PAGES=200
OCRROUTE_URL_ALLOWLIST=[]            # JSON list of hosts / *.domain patterns
OCRROUTE_URL_DENYLIST=[]
OCRROUTE_ALLOW_PRIVATE_URLS=false    # SSRF guard - leave false outside a lab
OCRROUTE_WORKER_THREADS=8
OCRROUTE_QUEUE_SIZE=200
OCRROUTE_DEFAULT_TIMEOUT=60
OCRROUTE_TOTAL_DEADLINE_MS=120000
OCRROUTE_BREAKER_THRESHOLD=5
OCRROUTE_BREAKER_COOLDOWN_SECONDS=120
OCRROUTE_CORS_ORIGINS=[]
OCRROUTE_LOG_LEVEL=INFO
OCRROUTE_JSON_LOGS=false
